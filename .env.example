# Names only. Leave values empty in git. Set them in the host's secret store.
# Never use a NEXT_PUBLIC_ prefix for these.

# "true" enables each part. All default off.
USPTO_LOOKUP_ENABLED=
USPTO_REMINDERS_ENABLED=
USPTO_APPLICATION_MONITORING_ENABLED=
USPTO_LIVE_EMAIL_ENABLED=

# Header USPTO-API-KEY for https://tsdrapi.uspto.gov. From https://account.uspto.gov/api-manager/
USPTO_TSDR_API_KEY=

# Header x-api-key for https://api.uspto.gov. From https://data.uspto.gov/apikey
USPTO_ODP_API_KEY=

# Bearer token required once any USPTO flag is true. Vercel Cron can send Authorization: Bearer $CRON_SECRET.
USPTO_CRON_SECRET=

# Proposed Postgres connection. This build does not connect even if this is set.
DATABASE_URL=

# Ignored while USPTO_LIVE_EMAIL_ENABLED is not exactly "true". Live email is not implemented.
USPTO_LIVE_EMAIL_TEST_RECIPIENT=
